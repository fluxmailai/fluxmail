{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:best-practices', 'schedule:weekly', 'group:allNonMajor'],
  // Dev dependencies keep the ranges used across the workspace, and actions
  // and Docker images keep their version tags.
  ignorePresets: [':pinDevDependencies', 'docker:pinDigests', 'helpers:pinGitHubActionDigests'],
  labels: ['dependencies'],
  semanticCommits: 'enabled',
  postUpdateOptions: ['pnpmDedupe'],
  ignoreDeps: [
    // The release process sets these versions.
    'fluxmail',
    'ghcr.io/fluxmailai/fluxmail',
  ],
  packageRules: [
    {
      matchManagers: ['npm'],
      rangeStrategy: 'bump',
    },
    {
      // Raising a peer range would make callers that pin an older compatible
      // version, such as Cloud, unmet peers. Widen it instead.
      matchManagers: ['npm'],
      matchDepTypes: ['peerDependencies'],
      rangeStrategy: 'widen',
    },
    {
      // Overrides the shorter default from config:best-practices. Keep this
      // at least as long as minimumReleaseAge in pnpm-workspace.yaml.
      matchDatasources: ['npm'],
      minimumReleaseAge: '7 days',
    },
    {
      // These match the minimum Node.js version we promise users.
      matchDepNames: ['node'],
      matchDepTypes: ['engines', 'uses-with'],
      enabled: false,
    },
    {
      // Cloud runs the provider adapters through @fluxmail/core, so review
      // these updates on their own.
      matchPackageNames: ['https-proxy-agent', 'iconv-lite', 'imapflow', 'libmime', 'postal-mime'],
      groupName: null,
      groupSlug: null,
    },
    {
      // @googleapis/gmail requires a matching googleapis-common major.
      matchPackageNames: ['@googleapis/gmail', 'googleapis-common'],
      groupName: 'Gmail client',
      groupSlug: 'gmail-client',
    },
    {
      matchPackageNames: ['nodemailer', '@types/nodemailer'],
      groupName: 'nodemailer',
      groupSlug: 'nodemailer',
    },
    {
      // These can change the shared MCP tool contract.
      matchPackageNames: ['@modelcontextprotocol/**'],
      groupName: 'MCP SDK',
      groupSlug: 'mcp-sdk',
    },
  ],
}
