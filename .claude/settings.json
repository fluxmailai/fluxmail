{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "script=\"$CLAUDE_PROJECT_DIR/scripts/worktree-setup.sh\"; [ ! -f \"$script\" ] || bash \"$script\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "script=\"$CLAUDE_PROJECT_DIR/.claude/hooks/require-code-review.mjs\"; [ -f \"$script\" ] || exit 0; input=$(cat); case \"$input\" in *gh*) printf '%s' \"$input\" | node \"$script\" ;; esac",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "script=\"$CLAUDE_PROJECT_DIR/scripts/worktree-setup.sh\"; [ ! -f \"$script\" ] || bash \"$script\"",
            "timeout": 600
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "script=\"$CLAUDE_PROJECT_DIR/scripts/worktree-setup.sh\"; [ ! -f \"$script\" ] || bash \"$script\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
